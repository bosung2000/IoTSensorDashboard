<Window x:Class="IoTSensorDashboard.ControlRoom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:IoTSensorDashboard.Ui.Common.Controls;assembly=IoTSensorDashboard.Ui.Common"
        xmlns:v="clr-namespace:IoTSensorDashboard.ControlRoom.Views"
        Title="관제실 — 라이브 파이프라인"
        Height="760" Width="1200" MinHeight="560" MinWidth="900" Left="10" Top="140"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="#FF070707"
        FontFamily="Segoe UI" FontSize="13">

    <!--
        ⚠️ AllowsTransparency="False" 를 지킬 것.
           True 로 바꾸면 ClearType 서브픽셀 렌더링이 꺼져 **한글이 눈에 띄게 뭉개진다.**
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" CornerRadius="8" GlassFrameThickness="0"
                            ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#FF383838" BorderThickness="1" CornerRadius="8" Background="#FF070707">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 배경은 전 행 아래에 깔린다.
                 패널이 「같은 평면에 붙은 스티커」가 아니라 「위에 떠 있는 판」으로 읽히게 한다. -->
            <ui:HudBackdrop Grid.RowSpan="6"/>

            <!-- ── Row 0 · 캡션 바 ───────────────────────────────────── -->
            <Grid Grid.Row="0" Background="#E8121519" Height="36">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Width="16" Height="16" CornerRadius="4" Background="#FF2962FF"/>
                    <TextBlock Text="관제실" Foreground="#FFDCDFE6" FontWeight="Bold"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="라이브 파이프라인 · F11 전체화면" Foreground="#FF7E8593"
                               FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="FullBtn" Content="⛶" Width="40" Height="36" Click="FullBtn_Click"
                            Background="Transparent" Foreground="#FF9AA0AC" BorderThickness="0"/>
                    <Button x:Name="MinBtn" Content="―" Width="40" Height="36" Click="MinBtn_Click"
                            Background="Transparent" Foreground="#FF9AA0AC" BorderThickness="0"/>
                    <Button x:Name="MaxBtn" Content="□" Width="40" Height="36" Click="MaxBtn_Click"
                            Background="Transparent" Foreground="#FF9AA0AC" BorderThickness="0"/>
                    <Button x:Name="CloseBtn" Content="✕" Width="40" Height="36" Click="CloseBtn_Click"
                            Background="Transparent" Foreground="#FF9AA0AC" BorderThickness="0"/>
                </StackPanel>
            </Grid>

            <!-- ── Row 1 · 상태 헤더 ─────────────────────────────────────
                 🔴 WrapPanel 이다. StackPanel 이 아니다.

                 📌 가로 StackPanel 은 넘친 컨트롤을 **조용히 잘라** 없는 것처럼 만든다.
                    상태 칩은 못 보면 못 누르는 것이므로, 줄이 늘어날지언정 사라지면 안 된다. -->
            <WrapPanel Grid.Row="1" Margin="14,10,14,6">
                <TextBlock Text="🖧 서버 파이프라인" Foreground="#FFDCDFE6"
                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="SubTitle" Text="센서 → 브로커 → 수집 → 코덱 → CORE → 대시보드"
                           Foreground="#FF7E8593" FontSize="11.5"
                           Margin="12,0,0,0" VerticalAlignment="Center"/>

                <ui:HudFrame Cut="4" Padding="10,4" Margin="16,0,0,0" Fill="#B00D1015">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="BrokerDot" Width="8" Height="8" Fill="#FF9AA0AC"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="BrokerText" Text="브로커 시작 중…" Foreground="#FFDCDFE6"
                                   FontSize="11.5" Margin="7,0,0,0"/>
                    </StackPanel>
                </ui:HudFrame>

                <TextBlock x:Name="StampText" Text="—" Foreground="#FF5A6272"
                           FontSize="10.5" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </WrapPanel>

            <!-- ── Row 2 · 상태 칩 2개 ───────────────────────────────────
                 🔴 이 칩을 헤더에 두지 않는다.

                 📌 문구 길이가 변할 때마다(「과부하 폐기 232,347건」) 줄이 접혔다 펴져
                    화면 전체가 위아래로 출렁인다.
                    값이 계속 바뀌는 칩은 폭 변화가 레이아웃을 흔들지 않는 곳에 둔다. -->
            <Grid Grid.Row="2" Margin="14,4,14,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Margin="0,8,0,0">
                    <ui:HudFrame Cut="4" Padding="10,5" Fill="#B00D1015" MinWidth="210">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="HealthDot" Width="8" Height="8" Fill="#FF9AA0AC"
                                     VerticalAlignment="Center"/>
                            <!-- 🔒 자동화가 이 문구를 읽어 판정한다.
                                 커스텀 렌더로 옮기면 UIA 노드가 사라져 그 게이트가 죽는다. -->
                            <TextBlock x:Name="HealthText"
                                       AutomationProperties.AutomationId="HealthText"
                                       Text="센서 —" Foreground="#FFDCDFE6" FontSize="11.5"
                                       Margin="7,0,0,0"/>
                        </StackPanel>
                    </ui:HudFrame>

                    <ui:HudFrame Cut="4" Padding="10,5" Margin="10,0,0,0" Fill="#B00D1015" MinWidth="210">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="IntegrityDot" Width="8" Height="8" Fill="#FF9AA0AC"
                                     VerticalAlignment="Center"/>
                            <TextBlock x:Name="IntegrityText"
                                       AutomationProperties.AutomationId="IntegrityText"
                                       Text="정합 —" Foreground="#FFDCDFE6" FontSize="11.5"
                                       Margin="7,0,0,0"/>
                        </StackPanel>
                    </ui:HudFrame>
                </StackPanel>

                <!-- 장애 조치 카드 — 평상시엔 헤더만 보인다. -->
                <ui:HudFrame Cut="4" Padding="12,8" Width="330" Emphasis="True" Fill="#E60D1015"
                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock Text="🛠 장애 조치" Foreground="#FFDCDFE6" FontWeight="Bold" FontSize="12"/>
                        <TextBlock x:Name="IncidentSummary" Text="활성 0건 · 정상"
                                   Foreground="#FF8A93A2" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </ui:HudFrame>
            </Grid>

            <!-- ── Row 3 · 파이프라인 그림 + 감지 피드 ──────────────────
                 🔑 이 화면의 주인공. 숫자 카드만으로는 **어느 단계가 막혔는지**
                    사람이 머릿속에서 이어 붙여야 한다. 순서대로 그리면 눈이 거기서 멈춘다. -->
            <Grid Grid.Row="3" Margin="14,2,14,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="290" MinWidth="150"/>
                </Grid.ColumnDefinitions>

                <v:PipelineView x:Name="Pipeline" Grid.Column="0" Margin="0,0,4,0"/>
                <v:EventFeedView x:Name="Feed" Grid.Column="1" Margin="4,0,0,0"/>
            </Grid>

            <!-- ── Row 4 · 실측 처리량 카드 6개 ──────────────────────── -->
            <UniformGrid Grid.Row="4" Rows="1" Columns="6" Margin="14,4,14,8">
                <ui:HudFrame Cut="4" Margin="0,0,5,0" Fill="#C00D1015" Accent="#FF5EEAD4">
                    <StackPanel>
                        <TextBlock x:Name="RxValue" Text="0" Foreground="#FFDCDFE6"
                                   FontSize="21" FontWeight="Bold"/>
                        <!-- 🔴 「이벤트」다. 「메시지」가 아니다 — 실측으로 드러난 라벨 오류.
                             한 메시지에 in·out 두 이벤트가 들어 있어, 팜에서 500 메시지/s 를
                             발행하면 여기는 1,000 이 뜬다. 라벨이 「메시지/s」였을 때
                             그 2배가 유실·중복처럼 보였다. 세는 것과 적는 것이 달랐던 것. -->
                        <TextBlock Text="수신 (이벤트/s)" Foreground="#FF8A909E" FontSize="10.5"/>
                    </StackPanel>
                </ui:HudFrame>

                <ui:HudFrame Cut="4" Margin="5,0" Fill="#C00D1015" Accent="#FF2962FF">
                    <StackPanel>
                        <TextBlock x:Name="WorkerValue" Text="0" Foreground="#FFDCDFE6"
                                   FontSize="21" FontWeight="Bold"/>
                        <TextBlock x:Name="WorkerLabel" Text="워커 (적응)" Foreground="#FF8A909E" FontSize="10.5"/>
                    </StackPanel>
                </ui:HudFrame>

                <ui:HudFrame Cut="4" Margin="5,0" Fill="#C00D1015" Accent="#FFC9A35F">
                    <StackPanel>
                        <TextBlock x:Name="BacklogValue" Text="0" Foreground="#FFDCDFE6"
                                   FontSize="21" FontWeight="Bold"/>
                        <TextBlock Text="백로그 (밀린 수)" Foreground="#FF8A909E" FontSize="10.5"/>
                    </StackPanel>
                </ui:HudFrame>

                <ui:HudFrame Cut="4" Margin="5,0" Fill="#C00D1015" Accent="#FF9AA2AE">
                    <StackPanel>
                        <TextBlock x:Name="LatValue" Text="0 µs" Foreground="#FFDCDFE6"
                                   FontSize="21" FontWeight="Bold"/>
                        <TextBlock Text="처리 지연 (도착→저장)" Foreground="#FF8A909E" FontSize="10.5"/>
                    </StackPanel>
                </ui:HudFrame>

                <ui:HudFrame Cut="4" Margin="5,0" Fill="#C00D1015" Accent="#FF7CFFE6">
                    <StackPanel>
                        <TextBlock x:Name="RxTotalValue" Text="0" Foreground="#FFDCDFE6"
                                   FontSize="21" FontWeight="Bold"/>
                        <!-- 🔑 기간을 반드시 쓴다. 팜의 「누적 발신」과 나란히 놓이면
                             기준이 다를 때 24배 차이가 나서 「데이터가 유실됐다」로 읽힌다.
                             계산 오류보다 이런 의미 불일치가 숫자 신뢰를 더 크게 깨뜨린다.

                             🔴 라벨이 「(전체 기간)」이었으나 **틀렸다** — 이 카운터는
                                DB 에서 복원하지 않는 순수 세션 값이다(재시작하면 0).
                                바로 옆 「누적 저장」은 진짜 전체 기간(DB 행 수)이라,
                                둘이 붙어 1,861 대 1,763,920 으로 보였다. -->
                        <TextBlock Text="누적 수신 (이번 세션)" Foreground="#FF8A909E" FontSize="10.5"/>
                    </StackPanel>
                </ui:HudFrame>

                <ui:HudFrame Cut="4" Margin="5,0,0,0" Fill="#C00D1015" Accent="#FF8BB4FF">
                    <StackPanel>
                        <TextBlock x:Name="StoreTotalValue" Text="0" Foreground="#FFDCDFE6"
                                   FontSize="21" FontWeight="Bold"/>
                        <TextBlock Text="누적 저장 (전체 기간)" Foreground="#FF8A909E" FontSize="10.5"/>
                    </StackPanel>
                </ui:HudFrame>
            </UniformGrid>

            <!-- ── Row 5 · 하단 상태바 ───────────────────────────────── -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="14,0,14,10">
                <TextBlock Text="내부 상태" FontSize="11" Foreground="#FF7E8593"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ui:HeartbeatBar x:Name="Vitals" Width="360" VerticalAlignment="Center"/>
                <TextBlock Text="· 마우스 오버 = 감시 대상 도움말" FontSize="10.5"
                           Foreground="#FF5A6272" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
