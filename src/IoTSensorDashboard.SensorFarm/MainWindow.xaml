<Window x:Class="IoTSensorDashboard.SensorFarm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:IoTSensorDashboard.Ui.Common.Controls;assembly=IoTSensorDashboard.Ui.Common"
        xmlns:local="clr-namespace:IoTSensorDashboard.SensorFarm"
        Title="센서 팜 — IoT 데모"
        Height="800" Width="1000"
        WindowStyle="None"
        AllowsTransparency="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Background="#FF070707"
        FontFamily="Segoe UI" FontSize="13">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" CornerRadius="8" GlassFrameThickness="0"
                            ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#FF383838" BorderThickness="1" CornerRadius="8" Background="#FF070707">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ui:HudBackdrop Grid.RowSpan="5"/>

            <!-- ── Row 0 · 캡션 바 ───────────────────────────────────── -->
            <Grid Grid.Row="0" Background="#E8121519" Height="36">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Width="16" Height="16" CornerRadius="4" Background="#FF5EEAD4"/>
                    <TextBlock Text="센서 팜" Foreground="#FFDCDFE6" FontWeight="Bold"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="IoT 데모 · F11 전체화면" Foreground="#FF7E8593"
                               FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="FullBtn" Content="⛶" Width="40" Height="36" Click="FullBtn_Click"
                            Background="Transparent" Foreground="#FF9AA0AC" BorderThickness="0"/>
                    <Button x:Name="MinBtn" Content="―" Width="40" Height="36" Click="MinBtn_Click"
                            Background="Transparent" Foreground="#FF9AA0AC" BorderThickness="0"/>
                    <Button x:Name="MaxBtn" Content="□" Width="40" Height="36" Click="MaxBtn_Click"
                            Background="Transparent" Foreground="#FF9AA0AC" BorderThickness="0"/>
                    <Button x:Name="CloseBtn" Content="✕" Width="40" Height="36" Click="CloseBtn_Click"
                            Background="Transparent" Foreground="#FF9AA0AC" BorderThickness="0"/>
                </StackPanel>
            </Grid>

            <!-- ── Row 1 · 상태 헤더 (WrapPanel — 잘리면 못 누른다) ──── -->
            <WrapPanel Grid.Row="1" Margin="14,10,14,4">
                <TextBlock Text="🛰 센서 팜" Foreground="#FFDCDFE6"
                           FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="SubTitle" Text="1,000대 · 실제 MQTT 발행"
                           Foreground="#FF7E8593" FontSize="11.5"
                           Margin="12,0,0,0" VerticalAlignment="Center"/>

                <ui:HudFrame Cut="4" Padding="10,4" Margin="14,0,0,0" Fill="#B00D1015">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnDot" Width="8" Height="8" Fill="#FF9AA0AC"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="ConnText" Text="브로커 연결 중…" Foreground="#FFDCDFE6"
                                   FontSize="11.5" Margin="7,0,0,0"/>
                    </StackPanel>
                </ui:HudFrame>

                <Button x:Name="AnomalyBtn" Content="⚡ 이상치 주입" Click="AnomalyBtn_Click"
                        Margin="10,0,0,0" Padding="10,4" Background="#FF1E1E1E"
                        Foreground="#FFEAC15A" BorderBrush="#FF383838" BorderThickness="1"/>
                <TextBlock x:Name="AnomalyLabel" Text="" Foreground="#FFEAC15A"
                           FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </WrapPanel>

            <!-- ── Row 2 · 발행 속도 + 가동률 ────────────────────────── -->
            <Grid Grid.Row="2" Margin="14,4,14,8">
                <WrapPanel>
                    <TextBlock Text="발신 레이트" Foreground="#FF8A909E" FontSize="11.5"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <!-- 🔑 MinWidth — 문구가 바뀔 때 레이아웃이 흔들리지 않게. -->
                    <TextBlock x:Name="RateLabel" Text="정지" MinWidth="150"
                               Foreground="#FF35C7FF" FontWeight="Bold" FontSize="15"
                               VerticalAlignment="Center"/>

                    <!-- 🔒 x:Name 은 반드시 ASCII.
                         자동화가 버튼 문구로 요소를 찾으면 문구를 다듬는 순간 검증이 깨진다. -->
                    <Button x:Name="PresetStopBtn" Content="정지" Tag="0" Click="Preset_Click"
                            Margin="6,0,0,0" Padding="10,4"/>
                    <Button x:Name="PresetRealBtn" Content="현실 (분당 1건)" Tag="batch" Click="Preset_Click"
                            Margin="6,0,0,0" Padding="10,4"/>
                    <Button x:Name="PresetNormalBtn" Content="정상 (17/s)" Tag="17" Click="Preset_Click"
                            Margin="6,0,0,0" Padding="10,4"/>
                    <Button x:Name="PresetFastBtn" Content="빠름 (500)" Tag="500" Click="Preset_Click"
                            Margin="6,0,0,0" Padding="10,4"/>
                    <Button x:Name="PresetSurgeBtn" Content="폭주 (5,000)" Tag="5000" Click="Preset_Click"
                            Margin="6,0,0,0" Padding="10,4"/>
                    <Button x:Name="PresetExtremeBtn" Content="극한 (20,000)" Tag="20000" Click="Preset_Click"
                            Margin="6,0,0,0" Padding="10,4"/>
                </WrapPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="UptimeLabel" Text="100%" Foreground="#FFEAC15A"
                               FontSize="26" FontWeight="Bold" HorizontalAlignment="Right"/>
                    <!-- 🔑 분자/분모를 같이 보여준다.
                         퍼센트만 있으면 「1,000대 중 몇 대인지」를 알 수 없다. -->
                    <TextBlock x:Name="UptimeSub" Text="1,000 / 1,000" Foreground="#FF8A909E"
                               FontSize="11" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>

            <!-- ── Row 3 · 센서 그리드 ───────────────────────────────── -->
            <local:SensorFarmView x:Name="Farm" Grid.Row="3" Margin="14,0,14,6"/>

            <!-- ── Row 4 · 하단 상태바 ───────────────────────────────── -->
            <WrapPanel Grid.Row="4" Margin="14,0,14,10">
                <TextBlock x:Name="SentLabel" Text="누적 발신 0 (이번 세션)" FontSize="11"
                           Foreground="#FF8A909E" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <!-- 🔴 유실은 0 이면 조용히, 0 이 아니면 경고색 + 건수.
                     「유실 0」을 쓸 수 있는 이유는 그걸 반증할 카운터가 있기 때문이다. -->
                <TextBlock x:Name="LossLabel" Text="유실 0" FontSize="11"
                           Foreground="#FF5A6272" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <TextBlock x:Name="BackfillLabel" Text="" FontSize="11"
                           Foreground="#FF35C7FF" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <ui:HeartbeatBar x:Name="Vitals" Width="220" VerticalAlignment="Center"/>
                <TextBlock Text="· 타일 클릭 = 오프라인 토글" FontSize="10.5"
                           Foreground="#FF5A6272" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </WrapPanel>
        </Grid>
    </Border>
</Window>
